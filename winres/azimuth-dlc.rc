#include <winver.h>
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 1,1,2,0
PRODUCTVERSION 1,1,2,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "FH3MP"
      VALUE "FileDescription", "Registers the converted FH3 expansions with Azimuth"
      VALUE "FileVersion", "1.1.2"
      VALUE "InternalName", "azimuth-dlc"
      VALUE "OriginalFilename", "azimuth-dlc.exe"
      VALUE "ProductName", "FH3 Expansions for Azimuth"
      VALUE "ProductVersion", "1.1.2"
      VALUE "LegalCopyright", "GPL-3.0, see LICENSE"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
