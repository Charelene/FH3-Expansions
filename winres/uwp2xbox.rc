#include <winver.h>
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "FH3MP"
      VALUE "FileDescription", "Converts the Windows copies of the FH3 expansions for Azimuth"
      VALUE "FileVersion", "1.1.0"
      VALUE "InternalName", "uwp2xbox"
      VALUE "OriginalFilename", "uwp2xbox.exe"
      VALUE "ProductName", "FH3 Expansions for Azimuth"
      VALUE "ProductVersion", "1.1.0"
      VALUE "LegalCopyright", "GPL-3.0, see LICENSE"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
